apiVersion: v1
baseDomain: {{ cluster_base_domain }}
compute:
- name: worker
  replicas: {{ worker_replicas }}
{% if worker_replicas | int > 0 and worker_instance_type is defined %}
  platform:
    aws:
      type: {{ worker_instance_type }}
{% endif %}
controlPlane:
  name: master
  replicas: {{ control_plane_replicas }}
  platform:
    aws:
      type: {{ control_plane_instance_type }}
metadata:
  name: {{ cluster_name }}
networking:
  # CIDRs are parameterized so Submariner-connected clusters can be given
  # NON-OVERLAPPING pod/service/machine ranges. Non-overlapping ranges let
  # Submariner run WITHOUT globalnet and route pod-to-pod directly, which is
  # required for cross-cluster live migration (virt-launcher <-> virt-launcher).
  clusterNetwork:
  - cidr: {{ cluster_network_cidr | default('10.128.0.0/14') }}
    hostPrefix: {{ cluster_network_host_prefix | default(23) }}
  machineNetwork:
  - cidr: {{ machine_network_cidr | default('10.0.0.0/16') }}
  networkType: OVNKubernetes
  serviceNetwork:
  - {{ service_network_cidr | default('172.30.0.0/16') }}
platform:
  aws:
    region: {{ aws_deploy_region }}
{% if not use_existing_vpc and aws_availability_zones is defined %}
    defaultMachinePlatform:
      zones:
{% for zone in aws_availability_zones %}
      - {{ zone }}
{% endfor %}
{% elif use_existing_vpc and aws_subnet_id is defined %}
{% if aws_availability_zone is defined %}
    defaultMachinePlatform:
      zones:
      - {{ aws_availability_zone }}
{% endif %}
    subnets:
    - {{ aws_subnet_id }}
{% endif %}
{% if use_existing_vpc and control_plane_replicas | int == 1 and worker_replicas | int == 0 %}
bootstrapInPlace:
  installationDisk: /dev/xvda
{% endif %}
pullSecret: '{{ pull_secret_content.content | b64decode | trim }}'
sshKey: '{{ ssh_key_content.content | b64decode | trim }}'
