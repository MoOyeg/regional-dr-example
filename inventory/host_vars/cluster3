---
# Example cluster configuration for US East 1
# Copy this file and modify for your cluster

# Cluster identification
cluster_name: "cluster3"
#cluster_base_domain: "example.com"  # Optional: will auto-detect from Route53 if not provided

# AWS account: named profile in ~/.aws/credentials ([cluster3] section)
aws_profile: "cluster2"

# AWS Configuration
aws_region: "us-east-2"
aws_availability_zone: "us-east-2a"
aws_instance_type: "m5.2xlarge"
aws_root_volume_size: 120
control_plane_replicas: 3
control_plane_instance_type: "m5.2xlarge"
worker_replicas: 3
worker_instance_type: "m5.4xlarge"
cluster_role: spoke
# RHCOS AMI for OpenShift 4.17 in us-east-1
# Find latest at: https://mirror.openshift.com/pub/openshift-v4/x86_64/dependencies/rhcos/
#aws_ami_id: "ami-0abcdef1234567890"

# Network Configuration - Update with your values
# aws_vpc_id: "vpc-xxxxxxxxxxxxxxxxx"
# aws_subnet_id: "subnet-xxxxxxxxxxxxxxxxx"
# aws_security_group_id: "sg-xxxxxxxxxxxxxxxxx"

# Submariner / cross-cluster live migration (cclm):
# NON-OVERLAPPING pod/service/machine CIDRs vs the other spoke (cluster2), so
# Submariner runs WITHOUT globalnet and routes pods directly. Required for the
# CCLM data plane (virt-launcher <-> virt-launcher). Keep distinct from cluster2.
cluster_network_cidr: "10.132.0.0/14"
cluster_network_host_prefix: 23
service_network_cidr: "172.31.0.0/16"
machine_network_cidr: "10.1.0.0/16"

# SSH Key (choose one):
# Option 1: Place ssh-key.pub in project root (auto-imported to EC2)
# Option 2: Use existing AWS EC2 key pair:
# aws_key_name: "my-keypair"

# Elastic IP
# aws_create_eip: true

# # Optional: Route53 DNS (comment out if not using)
# aws_route53_zone: "example.com"

# OpenShift version
openshift_version: "4.21"
