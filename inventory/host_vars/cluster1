---
# Example cluster configuration for EU West 1
# This cluster uses credential set 3

# Cluster identification
cluster_name: "cluster1"
cluster_role: hub
#cluster_base_domain: "example.com"  # Optional: will auto-detect from Route53 if not provided

# AWS account: named profile in ~/.aws/credentials ([cluster1] section)
aws_profile: "default"

# AWS Configuration
aws_region: "us-east-2"
aws_availability_zone: "us-east-2a"
aws_instance_type: "m5.2xlarge"
aws_root_volume_size: 120
control_plane_replicas: 3
control_plane_instance_type: "m5.2xlarge"
worker_replicas: 3
worker_instance_type: "m5.4xlarge"
netobserv: true

# RHCOS AMI for OpenShift 4.17 in us-east-1
#aws_ami_id: "ami-0123456789abcdef0"

# # Network Configuration - Update with your values
# aws_vpc_id: "vpc-zzzzzzzzzzzzzzzzz"
# aws_subnet_id: "subnet-zzzzzzzzzzzzzzzzz"
# aws_security_group_id: "sg-zzzzzzzzzzzzzzzzz"

# Cluster network CIDRs (optional; override the OCP defaults in the install-config).
# Give Submariner-connected clusters NON-OVERLAPPING pod/service/machine ranges to
# enable cross-cluster live migration without globalnet (see cluster2/cluster3).
# The hub is excluded from the Submariner set by default, so these are informational
# here - uncomment to override.
#cluster_network_cidr: "10.128.0.0/14"
#cluster_network_host_prefix: 23
#service_network_cidr: "172.30.0.0/16"
#machine_network_cidr: "10.0.0.0/16"

# SSH Key (choose one):
# Option 1: Place ssh-key.pub in project root (auto-imported to EC2)
# Option 2: Use existing AWS EC2 key pair:
# aws_key_name: "my-keypair"

# Elastic IP
aws_create_eip: true

# Optional: Route53 DNS
#aws_route53_zone: "example.com"

# OpenShift version
openshift_version: "4.21"