# OpenShift Cluster Configuration - IPI Mode Example
# IPI (Installer Provisioned Infrastructure): OpenShift creates all AWS resources

# Cluster identification
cluster_name: cluster-us-east-1-ipi

# Cluster role for DR operators (hub or spoke)
# Set to 'hub' for the ACM management cluster
# Defaults to 'spoke' from group_vars
# cluster_role: hub

# AWS Region
aws_region: us-east-1

# AWS account: named profile in ~/.aws/credentials ([section] per account)
# Create the profile with `aws configure --profile <name>` or edit the file.
aws_profile: "cluster1"

# Base Domain (Optional - auto-detected from Route53 if not specified)
# If you have a Route53 hosted zone, this will be automatically detected
# cluster_base_domain: example.com

# OpenShift Version (Optional - defaults to group_vars openshift_version)
# openshift_version: "4.21"

# Cluster network CIDRs (Optional - override the OCP defaults in install-config).
# Give Submariner-connected clusters NON-OVERLAPPING pod/service/machine ranges
# to enable cross-cluster live migration without globalnet. Each cluster in the
# Submariner set must use a DISTINCT set.
# cluster_network_cidr: "10.128.0.0/14"
# cluster_network_host_prefix: 23
# service_network_cidr: "172.30.0.0/16"
# machine_network_cidr: "10.0.0.0/16"

# Node topology (defaults: SNO with 1 master, 0 workers)
# control_plane_replicas: 1
# control_plane_instance_type: m5.2xlarge
# worker_replicas: 0
# worker_instance_type: m5.xlarge  # Only used when worker_replicas > 0

# IPI MODE - NO VPC/SUBNET/AMI CONFIGURATION NEEDED!
# When aws_vpc_id and aws_subnet_id are NOT specified, the playbook
# automatically uses IPI mode where OpenShift installer creates:
# - New VPC
# - Public and private subnets
# - Internet Gateway
# - NAT Gateway(s)
# - Route Tables
# - Security Groups
# - Load Balancers
# - EC2 instances
# - All required AWS resources

# Route53 Configuration (Optional)
# If you want automatic DNS record creation, set this to the hosted zone
# aws_route53_zone: example.com

# Deployment Notes:
# 1. Simpler configuration - no need to pre-create infrastructure
# 2. Ideal for testing, development, or DR scenarios
# 3. Deployment time: ~45-60 minutes
# 4. Clean destroy: openshift-install removes all created resources
# 5. Required IAM permissions: EC2, VPC, ELB, Route53 full access
