---
# Example cluster configuration for US West 2
# This cluster uses credential set 2

# Cluster identification
cluster_name: "cluster2"
#cluster_base_domain: "example.com"  # Optional: will auto-detect from Route53 if not provided

# AWS account: named profile in ~/.aws/credentials ([cluster2] section)
aws_profile: "cluster1"

# AWS Configuration
aws_region: "us-east-2"
aws_availability_zone: "us-east-2a"
aws_instance_type: "m5.2xlarge"
aws_root_volume_size: 120
control_plane_replicas: 3
control_plane_instance_type: "m5.2xlarge"
worker_replicas: 3
worker_instance_type: "m5.4xlarge"

cluster_role: spoke

# RHCOS AMI for OpenShift 4.17 in us-east-2
#aws_ami_id: "ami-0fedcba9876543210"

# Network Configuration - Update with your values
# aws_vpc_id: "vpc-yyyyyyyyyyyyyyyyy"
# aws_subnet_id: "subnet-yyyyyyyyyyyyyyyyy"
# aws_security_group_id: "sg-yyyyyyyyyyyyyyyyy"

# Submariner / cross-cluster live migration (cclm):
# NON-OVERLAPPING pod/service/machine CIDRs vs the other spoke (cluster3), so
# Submariner runs WITHOUT globalnet and routes pods directly. Required for the
# CCLM data plane (virt-launcher <-> virt-launcher). These are the OCP defaults;
# cluster3 uses a different set. Keep distinct from cluster3.
cluster_network_cidr: "10.128.0.0/14"
cluster_network_host_prefix: 23
service_network_cidr: "172.30.0.0/16"
machine_network_cidr: "10.0.0.0/16"

# SSH Key (choose one):
# Option 1: Place ssh-key.pub in project root (auto-imported to EC2)
# Option 2: Use existing AWS EC2 key pair:
# aws_key_name: "my-keypair"

# Elastic IP
aws_create_eip: true

# Optional: Route53 DNS
# aws_route53_zone: "example.com"

# OpenShift version
openshift_version: "4.22.5"
